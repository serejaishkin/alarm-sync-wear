<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Play flavor only: X1 Health Connect reads recent sleep sessions after
         explicit in-app opt-in and Health Connect permission grant. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <service
        android:name=".sync.PhoneWakeSyncListenerService"
        android:exported="true">
        <intent-filter>
            <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
            <data android:scheme="wear" android:host="*" android:pathPrefix="/wakesync/" />
        </intent-filter>
    </service>

    <provider
        android:name=".sync.WakeSyncStartupProvider"
        android:authorities="${applicationId}.wakesync.startup"
        android:exported="false"
        android:initOrder="100" />

</manifest>
